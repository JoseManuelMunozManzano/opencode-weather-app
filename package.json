{
  "name": "02-weather",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "test:watch": "bun test --isolate --watch",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun test --isolate && bunx tsc --noEmit && bun build --compile src/index.ts --outfile weather",
    "start": "bun run src/index.ts",
    "dev": "bun run src/index.ts --watch"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
